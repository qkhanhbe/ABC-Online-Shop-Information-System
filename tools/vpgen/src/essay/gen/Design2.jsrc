package essay.gen;

import com.vp.plugin.diagram.IDiagramTypeConstants;
import com.vp.plugin.diagram.IDiagramUIModel;

/**
 * Design diagrams added after the essay was generated, drawn from the code of abc_shop:
 * SD06 Track Order (Design) - controller/order_controller.py OrderController.track,
 * service/order_service.py OrderService.track / own_order, dao/sqlite_dao.py.
 */
public class Design2 extends Ch4 {

    void run(String codes) {
        init();
        ownerPackage("Design (added)");
        if (codes.contains("SD06")) trackDesignSequence();
        if (codes.contains("DCL05")) dataAccessLayer();
    }

    void trackDesignSequence() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_INTERACTION_DIAGRAM, "SD06 Track Order (Design)");
        int h = 760;
        lifeline(d, "Customer", null, 10, 80, h);
        lifeline(d, "WebApp", "boundary", 120, 90, h);
        lifeline(d, "OrderController", "boundary", 240, 120, h);
        lifeline(d, "AuthService", "control", 400, 100, h);
        lifeline(d, "OrderService", "control", 540, 110, h);
        lifeline(d, "OrderDAO", "entity", 690, 90, h);
        lifeline(d, "ShipmentDAO", "entity", 820, 100, h);
        lifeline(d, "templates", "boundary", 960, 90, h);
        String[][] m = {
            {"Customer", "WebApp", "1", "GET /orders/O011", "0"},
            {"WebApp", "OrderController", "2", "track(request, order_id)", "0"},
            {"OrderController", "AuthService", "3", "require(request.user, \"own_orders\")", "0"},
            {"AuthService", "OrderController", "4", "customer", "1"},
            {"OrderController", "OrderService", "5", "track(customer.user_id, order_id)", "0"},
            {"OrderService", "OrderService", "6", "own_order(customer_id, order_id)", "0"},
            {"OrderService", "OrderDAO", "7", "get_order(order_id)", "0"},
            {"OrderDAO", "OrderService", "8", "order", "1"},
            {"OrderService", "ShipmentDAO", "9", "get_by_order(order.order_id)", "0"},
            {"ShipmentDAO", "OrderService", "10", "shipment or None", "1"},
            {"OrderService", "OrderController", "11", "{order, status, carrier_ref, timeline, last_update}", "1"},
            {"OrderController", "templates", "12", "track(request, tracking)", "0"},
            {"templates", "OrderController", "13", "html", "1"},
            {"OrderController", "WebApp", "14", "Response(html)", "1"},
            {"WebApp", "Customer", "15", "200 order page with status timeline", "1"}};
        int y = 120;
        int[] ys = new int[m.length];
        for (int k = 0; k < m.length; k++) {
            ys[k] = y;
            msg(d, m[k][0], m[k][1], m[k][2], m[k][3], y, "1".equals(m[k][4]));
            y += m[k][0].equals(m[k][1]) ? 55 : 38;
        }
        activate(d, "Customer", ys[0], ys[14]);
        activate(d, "WebApp", ys[0], ys[14]);
        activate(d, "OrderController", ys[1], ys[13]);
        activate(d, "AuthService", ys[2], ys[3]);
        activate(d, "OrderService", ys[4], ys[10]);
        activate(d, "OrderDAO", ys[6], ys[7]);
        activate(d, "ShipmentDAO", ys[8], ys[9]);
        activate(d, "templates", ys[11], ys[12]);
        note(d, "alt [3: no user or no 'own_orders' permission]  PermissionDenied: WebApp redirects to /login.\n"
             + "alt [6-8: order is None or order.customer_id != customer_id]  NotFound(\"order not found\"): "
             + "WebApp answers 404, a foreign order looks like a missing one (UC11 E2).\n"
             + "opt [10: shipment is not None]  the carrier milestones are added to the order history; "
             + "the timeline is sorted by time.", 300, y + 20, 900, 96);
    }

    static final String[][] DAOS = {
        {"CustomerDAO", "get_user(user_id);find_by_email(email);save_user(user);list_customers()"},
        {"ProductDAO", "get_product(product_id);list_products(category_id=None, active_only=True);save_product(product);get_category(category_id);list_categories();save_category(category)"},
        {"InventoryDAO", "get_stock(product_id);save_stock(stock);find_event(product_id, kind, reference);add_event(event);events_for(product_id, limit=10);add_replenishment(request_id, product_id, quantity, at);open_replenishments()"},
        {"PromotionDAO", "get_promotion(code);save_promotion(promotion);list_promotions()"},
        {"ReviewDAO", "for_product(product_id, status=published);exists(customer_id, product_id, order_id);save_review(review);list_reviews(status=None)"},
        {"CartDAO", "get_cart(customer_id);update_cart(cart)"},
        {"OrderDAO", "get_order(order_id);find_by_idempotency_key(key);find_by_customer(customer_id);find_by_status(*statuses);save_order(order);list_orders()"},
        {"PaymentDAO", "get_by_attempt(attempt_ref);for_order(order_id);save_payment(payment)"},
        {"ShipmentDAO", "get_by_order(order_id);get_by_carrier_ref(carrier_ref);save_shipment(shipment)"},
        {"AuditDAO", "record(actor, action, entity, entity_id, detail=);recent(limit=20)"}};

    /** DCL05: dao/interfaces.py, dao/sqlite_dao.py, dao/database.py, dao/vector_index.py, dao/image_storage.py. */
    void dataAccessLayer() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_CLASS_DIAGRAM, "DCL05 Data Access Layer");
        com.vp.plugin.model.IClass db = cls("Database", null, new String[] {"-path : str", "-conn : sqlite3.Connection"},
            new String[] {"init_schema()", "now()", "transaction()", "execute(sql, params=())", "query(sql, params=())",
                          "query_one(sql, params=())", "next_id(name, prefix, width=3)", "close()"});
        put(d, db, "Database", 0, 0, 100, 100, BLUE);
        com.vp.plugin.model.IClass vi = cls("VectorIndex", null, new String[] {"-vectors : dict"},
            new String[] {"build(storage, products, encode)", "add(product_id, embedding)", "search(query_embedding, k=None)"});
        put(d, vi, "VectorIndex", 0, 0, 100, 100, BLUE);
        com.vp.plugin.model.IClass is = cls("ImageStorage", null, new String[] {"-root : str"},
            new String[] {"path(relative)", "exists(relative)", "save_upload(filename, content)"});
        put(d, is, "ImageStorage", 0, 0, 100, 100, BLUE);
        link(d, use(vi, is), shapes.get("VectorIndex"), shapes.get("ImageStorage"));
        for (String[] dao : DAOS) {
            com.vp.plugin.model.IClass i = cls(dao[0], "interface", null, dao[1].split(";"));
            put(d, i, dao[0], 0, 0, 100, 100, LIGHT);
            com.vp.plugin.model.IClass impl = cls("Sqlite" + dao[0], null, new String[] {"-db : Database"}, null);
            put(d, impl, "Sqlite" + dao[0], 0, 0, 100, 100, BLUE);
            link(d, realize(impl, i), shapes.get(dao[0]), shapes.get("Sqlite" + dao[0]));
            link(d, assoc(impl, db, null, "1", null, null), shapes.get("Sqlite" + dao[0]), shapes.get("Database"));
        }
    }
}
