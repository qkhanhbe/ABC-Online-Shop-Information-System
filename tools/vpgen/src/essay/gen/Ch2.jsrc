import com.vp.plugin.model.*;

/** Chapter 2 - Analysis: activity, DFD, sequence, class, state and data models. */
public class Ch2 extends Ch1 {

    // ------------------------------------------------------------------ class boxes
    /** Class shape sized from its text, so it renders the same with or without fitSize. */
    IShapeUIModel box(IDiagramUIModel d, IClass c, String key, int x, int y, Color bg) {
        int longest = c.getName().length() + 4;
        int lines = 0;
        for (IAttribute a : c.toAttributeArray()) {
            longest = Math.max(longest, a.getName().length() + String.valueOf(a.getTypeAsString()).length() + 6);
            lines++;
        }
        int ops = 0;
        for (IOperation o : c.toOperationArray()) {
            int len = o.getName().length() + 6 + (o.getReturnTypeAsString() == null ? 0 : o.getReturnTypeAsString().length());
            for (IParameter p : o.toParameterArray()) {
                len += p.getName().length() + String.valueOf(p.getTypeAsString()).length() + 5;
            }
            longest = Math.max(longest, len);
            ops++;
        }
        int st = c.toStereotypeArray() != null && c.toStereotypeArray().length > 0 ? 15 : 0;
        int w = Math.max(110, (int) (longest * 6.7) + 26);
        int h = 30 + st + Math.max(1, lines) * 17 + 8 + Math.max(1, ops) * 17 + 8;
        return put(d, c, key, x, y, w, h, bg);
    }

    /** Columns of classes, each stacked top-down; column x follows the widest box of the previous one. */
    void columns(IDiagramUIModel d, String prefix, String[][] cols, int x0, int y0, Color bg) {
        int x = x0;
        for (String[] col : cols) {
            int y = y0, widest = 0;
            for (String n : col) {
                IShapeUIModel sh = box(d, (IClass) named.get(prefix + n), n, x, y, bg);
                y += sh.getHeight() + 45;
                widest = Math.max(widest, sh.getWidth());
            }
            x += widest + 70;
        }
    }

    IClass klass(String key, String name, String st, String[] attrs, String[] ops) {
        IClass c = cls(name, st, attrs, ops);
        named.put(key, c);
        return c;
    }

    IConnectorUIModel rel(IDiagramUIModel d, IModelElement r, String a, String b) {
        IConnectorUIModel c = link(d, r, shapes.get(a), shapes.get(b));
        if (c != null && r.getName() != null && !r.getName().isEmpty()) {
            c.setShowConnectorName(0);
        }
        return c;
    }

    void associate(IDiagramUIModel d, String a, String b, String ma, String mb, String name, String kind) {
        rel(d, assoc(shapes.get(a).getModelElement(), shapes.get(b).getModelElement(), ma, mb, name, kind), a, b);
    }

    void inherit(IDiagramUIModel d, String child, String parent) {
        rel(d, gen(shapes.get(child).getModelElement(), shapes.get(parent).getModelElement()), parent, child);
    }

    void uses(IDiagramUIModel d, String client, String supplier) {
        rel(d, use(shapes.get(client).getModelElement(), shapes.get(supplier).getModelElement()), client, supplier);
    }

    // ------------------------------------------------------------------ activity helpers
    static final Color ACTION = new Color(126, 205, 238);

    final class Node {
        final IModelElement model;
        final IShapeUIModel shape;
        Node(IModelElement m, IShapeUIModel s) { model = m; shape = s; }
    }

    void cflow(IDiagramUIModel d, IModelElement owner, Node a, Node b, String guard) {
        IControlFlow c = f.createControlFlow();
        c.setFrom(a.model);
        c.setTo(b.model);
        if (guard != null) {
            c.setGuard(guard);
        }
        if (owner != null) {
            owner.addChild(c);
        }
        IConnectorUIModel ui = link(d, c, a.shape, b.shape);
        if (guard != null && ui != null) {
            ui.setShowConnectorName(0);
            ui.setRequestResetCaption(true);
        }
    }

    Node act(IDiagramUIModel d, String name, int x, int y, int w) {
        IActivityAction a = f.createActivityAction();
        a.setName(name);
        return new Node(a, put(d, a, null, x, y, w, 50, ACTION));
    }

    Node decision(IDiagramUIModel d, String name, int x, int y) {
        IDecisionNode n = f.createDecisionNode();
        n.setName(name);
        return new Node(n, put(d, n, null, x, y, 110, 70, YELLOW));
    }

    Node merge(IDiagramUIModel d, int x, int y) {
        IMergeNode n = f.createMergeNode();
        n.setName("");
        return new Node(n, put(d, n, null, x, y, 50, 40, YELLOW));
    }

    Node start(IDiagramUIModel d, int x, int y) {
        IInitialNode n = f.createInitialNode();
        return new Node(n, put(d, n, null, x, y, 26, 26, Color.BLACK));
    }

    Node end(IDiagramUIModel d, int x, int y) {
        IActivityFinalNode n = f.createActivityFinalNode();
        return new Node(n, put(d, n, null, x, y, 28, 28, Color.WHITE));
    }

    /** Vertical swimlanes; node x positions are relative to their lane. */
    final class Lanes {
        final IDiagramUIModel d;
        final IActivitySwimlane2 model;
        final IActivitySwimlane2NewUIModel shape;
        final Map<String, IActivityPartition> parts = new LinkedHashMap<String, IActivityPartition>();
        final Map<String, IActivitySwimlane2CompartmentUIModel> cells = new LinkedHashMap<String, IActivitySwimlane2CompartmentUIModel>();
        final Map<String, Integer> index = new LinkedHashMap<String, Integer>();
        final int width, ox = 40, oy = 40;

        Lanes(String name, String[] names, int width, int height) {
            d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_ACTIVITY_DIAGRAM, name);
            d.setConnectorStyle(1);
            this.width = width;
            model = f.createActivitySwimlane2();
            shape = (IActivitySwimlane2NewUIModel) dm.createDiagramElement(d, model);
            shape.setBounds(ox, oy, width * names.length, height);
            shape.setForeground(LINE);
            String[] headers = new String[names.length], cellIds = new String[names.length];
            for (int i = 0; i < names.length; i++) {
                IActivityPartition p = f.createActivityPartition();
                p.setName(names[i]);
                model.addVerticalPartition(p);
                model.addChild(p);
                parts.put(names[i], p);
                index.put(names[i], i);
                IActivityPartitionHeaderUIModel h = (IActivityPartitionHeaderUIModel) dm.createDiagramElement(d, p);
                h.setHorizontal(false);
                h.setSwimlane(shape);
                h.setBounds(ox + i * width, oy, width, 34);
                fill(h, new Color(91, 170, 214));
                h.setRequestResetCaption(true);
                shape.addChild(h);
                headers[i] = h.getId();
                IActivitySwimlane2CompartmentUIModel c = (IActivitySwimlane2CompartmentUIModel)
                    dm.createDiagramElement(d, IShapeTypeConstants.SHAPE_TYPE_ACTIVITY_SWIMLANE2_COMPARTMENT);
                c.setVerticalPartitionId(h.getId());
                c.setBounds(ox + i * width, oy + 34, width, height - 34);
                fill(c, i % 2 == 0 ? new Color(245, 250, 253) : Color.WHITE);
                shape.addChild(c);
                cells.put(names[i], c);
                cellIds[i] = c.getId();
            }
            shape.setVerticalPartitionIds(headers);
            shape.setCompartmentIds(cellIds);
        }

        Node place(String lane, IModelElement m, int x, int y, int w, int h, Color bg) {
            model.addChild(m);
            parts.get(lane).addContainedElement(m);
            IShapeUIModel s = put(d, m, null, ox + index.get(lane) * width + x, oy + y, w, h, bg);
            cells.get(lane).addChild(s);
            return new Node(m, s);
        }

        Node action(String lane, String name, int y) {
            IActivityAction a = f.createActivityAction();
            a.setName(name);
            return place(lane, a, 20, y, width - 40, 50, ACTION);
        }

        Node decision(String lane, String name, int y) {
            IDecisionNode n = f.createDecisionNode();
            n.setName(name);
            return place(lane, n, width / 2 - 55, y, 110, 70, YELLOW);
        }

        Node start(String lane, int y) {
            return place(lane, f.createInitialNode(), width / 2 - 13, y, 26, 26, Color.BLACK);
        }

        Node end(String lane, int x, int y) {
            return place(lane, f.createActivityFinalNode(), x, y, 28, 28, Color.WHITE);
        }

        void flow(Node a, Node b) { cflow(d, model, a, b, null); }

        void flow(Node a, Node b, String guard) { cflow(d, model, a, b, guard); }
    }

    // ------------------------------------------------------------------ diagrams
    void placeOrderActivity() {
        Lanes l = new Lanes("AD01 Place Order (Swimlane)", new String[] {"Customer", "System", "Payment Provider"}, 300, 1300);
        Node s = l.start("Customer", 50);
        Node a1 = l.action("Customer", "Select Checkout from cart", 100);
        Node a2 = l.action("System", "Validate cart lines and prices (UC29)", 180);
        Node a3 = l.action("System", "Check availability (UC30)", 260);
        Node d1 = l.decision("System", "Cart valid?", 340);
        Node e1 = l.action("Customer", "[No] Correct quantities in cart", 355);
        Node x1 = l.end("Customer", 136, 430);
        Node a4 = l.action("Customer", "Confirm address, enter promotion code", 470);
        Node a5 = l.action("System", "Apply promotion (UC32), calculate total (UC31)", 550);
        Node a6 = l.action("Customer", "Confirm purchase", 630);
        Node a7 = l.action("System", "Reserve stock and create Payment Pending order", 710);
        Node a8 = l.action("System", "Send referenced payment request (UC09)", 790);
        Node a9 = l.action("Payment Provider", "Authorise payment", 790);
        Node a10 = l.action("Payment Provider", "Return signed result", 870);
        Node d2 = l.decision("System", "Verified success?", 950);
        Node a11 = l.action("System", "[Yes] Mark Paid/Confirmed, clear cart", 1060);
        Node a12 = l.action("Customer", "[No] See failure, cart kept", 1060);
        Node r1 = l.action("System", "[No] Release reservation, Payment Failed", 1140);
        Node a13 = l.action("Customer", "View order confirmation", 1160);
        Node x2 = l.end("Customer", 136, 1240);
        Node x3 = l.end("Payment Provider", 136, 1160);
        l.flow(s, a1); l.flow(a1, a2); l.flow(a2, a3); l.flow(a3, d1);
        l.flow(d1, e1, "No"); l.flow(e1, x1); l.flow(d1, a4, "Yes");
        l.flow(a4, a5); l.flow(a5, a6); l.flow(a6, a7); l.flow(a7, a8); l.flow(a8, a9); l.flow(a9, a10);
        l.flow(a10, d2); l.flow(d2, a11, "Yes"); l.flow(d2, r1, "No"); l.flow(r1, a12); l.flow(a12, x3);
        l.flow(a11, a13); l.flow(a13, x2);
    }

    void fulfilmentActivity() {
        Lanes l = new Lanes("AD02 Process and Ship Order (Swimlane)",
                            new String[] {"Sales Staff", "System", "Warehouse Staff", "Shipping Provider"}, 250, 1100);
        Node s = l.start("Sales Staff", 50);
        Node a1 = l.action("Sales Staff", "Open processing queue", 100);
        Node a2 = l.action("System", "List Paid/Confirmed and On Hold orders", 180);
        Node a3 = l.action("Sales Staff", "Select order, confirm processing", 260);
        Node a4 = l.action("System", "Verify payment and reservations", 340);
        Node d1 = l.decision("System", "Eligible?", 420);
        Node h = l.action("Sales Staff", "[No] Order On Hold, exception recorded", 520);
        Node xh = l.end("Sales Staff", 111, 600);
        Node a5 = l.action("System", "[Yes] Set Processing, add to pick list", 520);
        Node a6 = l.action("Warehouse Staff", "Pick and pack items", 600);
        Node a7 = l.action("System", "Issue stock, create shipment, Ready for Shipment", 680);
        Node a8 = l.action("Warehouse Staff", "Hand parcel to carrier", 760);
        Node a9 = l.action("Shipping Provider", "Create delivery, return carrier reference", 760);
        Node a10 = l.action("Shipping Provider", "Send milestones (picked up ... delivered)", 860);
        Node a11 = l.action("System", "Accept new milestones, update order status", 940);
        Node x = l.end("System", 111, 1030);
        l.flow(s, a1); l.flow(a1, a2); l.flow(a2, a3); l.flow(a3, a4); l.flow(a4, d1);
        l.flow(d1, h, "No"); l.flow(h, xh); l.flow(d1, a5, "Yes"); l.flow(a5, a6); l.flow(a6, a7);
        l.flow(a7, a8); l.flow(a8, a9); l.flow(a9, a10); l.flow(a10, a11); l.flow(a11, x);
    }

    void inventoryActivity() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_ACTIVITY_DIAGRAM, "AD03 Manage Inventory");
        d.setConnectorStyle(1);
        Node s = start(d, 287, 20);
        Node a1 = act(d, "Warehouse Staff: select product and event type", 160, 70, 280);
        Node a2 = act(d, "System: show physical, reserved, available, recent events", 160, 150, 280);
        Node a3 = act(d, "Warehouse Staff: enter quantity, reference, reason", 160, 230, 280);
        Node dup = decision(d, "Reference already recorded?", 245, 310);
        Node r0 = act(d, "[Yes] Return earlier event, no change", 470, 320, 230);
        Node x0 = end(d, 571, 400);
        Node d1 = decision(d, "Resulting balance valid?", 245, 420);
        Node r1 = act(d, "[No] Reject event and explain", 470, 430, 230);
        Node x1 = end(d, 571, 510);
        Node a4 = act(d, "System: record event, recalculate stock atomically", 160, 530, 280);
        Node d2 = decision(d, "Available <= threshold?", 245, 610);
        Node a5 = act(d, "[Yes] Flag low stock, offer UC24 replenishment", 470, 620, 260);
        Node m = merge(d, 275, 720);
        Node a6 = act(d, "System: display new balance and event id", 160, 790, 280);
        Node x2 = end(d, 286, 870);
        cflow(d, null, s, a1, null); cflow(d, null, a1, a2, null); cflow(d, null, a2, a3, null);
        cflow(d, null, a3, dup, null); cflow(d, null, dup, r0, "Yes"); cflow(d, null, r0, x0, null);
        cflow(d, null, dup, d1, "No"); cflow(d, null, d1, r1, "No"); cflow(d, null, r1, x1, null);
        cflow(d, null, d1, a4, "Yes"); cflow(d, null, a4, d2, null); cflow(d, null, d2, a5, "Yes");
        cflow(d, null, a5, m, null); cflow(d, null, d2, m, "No"); cflow(d, null, m, a6, null);
        cflow(d, null, a6, x2, null);
    }

