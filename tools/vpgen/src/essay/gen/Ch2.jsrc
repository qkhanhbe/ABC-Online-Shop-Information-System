    void analysisClasses() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_CLASS_DIAGRAM, "CL01 Analysis Class Diagram");
        ownerPackage("Analysis Model");
        klass("user", "User", null, new String[] {"userId : String", "name : String", "email : String", "role : String"}, null);
        klass("cus", "Customer", null, new String[] {"createdAt : DateTime"}, null);
        klass("addr", "Address", null, new String[] {"receiver : String", "phone : String", "street : String", "city : String"}, null);
        klass("cat", "Category", null, new String[] {"categoryId : String", "name : String"}, null);
        klass("prod", "Product", null, new String[] {"productId : String", "name : String", "brand : String", "color : String", "price : float", "status : String"}, null);
        klass("stock", "StockLevel", null, new String[] {"physical : int", "reserved : int", "threshold : int", "/available : int"}, null);
        klass("ev", "InventoryEvent", null, new String[] {"eventId : String", "kind : EventKind", "quantity : int", "reference : String", "reason : String"}, null);
        klass("cart", "Cart", null, new String[] {"cartId : String"}, null);
        klass("ci", "CartItem", null, new String[] {"quantity : int", "cartPrice : float"}, null);
        klass("promo", "Promotion", null, new String[] {"code : String", "percent : float", "minTotal : float", "start : Date", "end : Date"}, null);
        klass("ord", "Order", null, new String[] {"orderId : String", "status : OrderStatus", "discount : float", "shippingFee : float", "createdAt : DateTime", "idempotencyKey : String"}, null);
        klass("oi", "OrderItem", null, new String[] {"quantity : int", "unitPrice : float"}, null);
        klass("hist", "StatusChange", null, new String[] {"status : OrderStatus", "actor : String", "at : DateTime", "note : String"}, null);
        klass("pay", "Payment", null, new String[] {"attemptRef : String", "amount : float", "currency : String", "status : String", "providerRef : String"}, null);
        klass("ship", "Shipment", null, new String[] {"shipmentId : String", "carrierRef : String", "status : String"}, null);
        klass("ms", "Milestone", null, new String[] {"seq : int", "code : String", "at : DateTime"}, null);
        klass("rev", "Review", null, new String[] {"rating : int", "text : String", "status : String"}, null);
        IDiagramUIModel dd = d;
        box(dd, (IClass) named.get("user"), "user", 40, 30, LIGHT);
        box(dd, (IClass) named.get("cus"), "cus", 40, 200, LIGHT);
        box(dd, (IClass) named.get("addr"), "addr", 40, 330, LIGHT);
        box(dd, (IClass) named.get("cart"), "cart", 330, 200, LIGHT);
        box(dd, (IClass) named.get("ci"), "ci", 330, 330, LIGHT);
        box(dd, (IClass) named.get("ord"), "ord", 330, 480, LIGHT);
        box(dd, (IClass) named.get("oi"), "oi", 330, 700, LIGHT);
        box(dd, (IClass) named.get("hist"), "hist", 40, 520, LIGHT);
        box(dd, (IClass) named.get("pay"), "pay", 40, 700, LIGHT);
        box(dd, (IClass) named.get("promo"), "promo", 330, 30, LIGHT);
        box(dd, (IClass) named.get("prod"), "prod", 660, 330, LIGHT);
        box(dd, (IClass) named.get("cat"), "cat", 660, 160, LIGHT);
        box(dd, (IClass) named.get("stock"), "stock", 930, 330, LIGHT);
        box(dd, (IClass) named.get("ev"), "ev", 930, 500, LIGHT);
        box(dd, (IClass) named.get("ship"), "ship", 660, 700, LIGHT);
        box(dd, (IClass) named.get("ms"), "ms", 930, 700, LIGHT);
        box(dd, (IClass) named.get("rev"), "rev", 660, 520, LIGHT);
        inherit(dd, "cus", "user");
        associate(dd, "cus", "addr", "1", "0..1", "delivers to", "aggregation");
        associate(dd, "cus", "cart", "1", "1", "owns", null);
        associate(dd, "cart", "ci", "1", "0..*", null, "composition");
        associate(dd, "ci", "prod", "0..*", "1", "refers to", null);
        associate(dd, "cus", "ord", "1", "0..*", "places", null);
        associate(dd, "ord", "oi", "1", "1..*", null, "composition");
        associate(dd, "oi", "prod", "0..*", "1", null, null);
        associate(dd, "ord", "hist", "1", "1..*", "history", "composition");
        associate(dd, "ord", "pay", "1", "0..*", "paid by", null);
        associate(dd, "ord", "promo", "0..*", "0..1", "uses", null);
        associate(dd, "ord", "ship", "1", "0..1", "shipped as", null);
        associate(dd, "ship", "ms", "1", "0..*", null, "composition");
        associate(dd, "prod", "cat", "0..*", "1", "belongs to", null);
        associate(dd, "prod", "stock", "1", "1", null, null);
        associate(dd, "stock", "ev", "1", "0..*", "explained by", null);
        associate(dd, "rev", "prod", "0..*", "1", "about", null);
        associate(dd, "rev", "ord", "0..*", "1", "verified by", null);
    }

    void orderStateMachine() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_STATE_DIAGRAM, "ST01 Order State Machine");
        String[][] st = {
            {"pp", "Payment Pending", "430", "110"}, {"pf", "Payment Failed", "40", "110"},
            {"paid", "Paid/Confirmed", "430", "270"}, {"hold", "On Hold", "820", "270"},
            {"proc", "Processing", "430", "430"}, {"ready", "Ready for Shipment", "430", "590"},
            {"ship", "Shipped", "430", "740"}, {"df", "Delivery Failed", "820", "740"},
            {"del", "Delivered", "430", "900"}, {"can", "Cancelled", "40", "590"}};
        for (String[] s : st) {
            IState2 m = f.createState2();
            m.setName(s[1]);
            put(d, m, s[0], Integer.parseInt(s[2]), Integer.parseInt(s[3]), 170, 50, BLUE);
        }
        put(d, f.createInitialPseudoState(), "init", 503, 20, 24, 24, null);
        put(d, f.createFinalState2(), "fin1", 502, 1010, 26, 26, null);
        put(d, f.createFinalState2(), "fin2", 112, 720, 26, 26, null);
        put(d, f.createFinalState2(), "fin3", 112, 20, 26, 26, null);
        String[][] tr = {
            {"init", "pp", "place order [cart valid] / reserve stock"},
            {"pp", "paid", "payment succeeded"},
            {"pp", "pf", "payment declined"},
            {"pf", "fin3", ""},
            {"pp", "can", "cancel"},
            {"paid", "proc", "confirm [paid, reserved]"},
            {"paid", "hold", "manual check"},
            {"hold", "proc", "resolved"},
            {"paid", "can", "cancel"},
            {"proc", "can", "cancel"},
            {"proc", "ready", "packed / issue stock"},
            {"ready", "ship", "PICKED_UP"},
            {"ship", "df", "FAILED_ATTEMPT"},
            {"df", "del", "DELIVERED (retry)"},
            {"ship", "del", "DELIVERED"},
            {"del", "fin1", ""},
            {"can", "fin2", ""}};
        for (String[] t : tr) {
            ITransition2 x = f.createTransition2();
            x.setFrom(shapes.get(t[0]).getModelElement());
            x.setTo(shapes.get(t[1]).getModelElement());
            if (!t[2].isEmpty()) {
                x.setName(t[2]);
            }
            IShapeUIModel a = shapes.get(t[0]), b = shapes.get(t[1]);
            boolean canonical = t[0].compareTo(t[1]) < 0;
            IShapeUIModel p = canonical ? a : b, q = canonical ? b : a;
            double dx = q.getX() + q.getWidth() / 2.0 - p.getX() - p.getWidth() / 2.0;
            double dy = q.getY() + q.getHeight() / 2.0 - p.getY() - p.getHeight() / 2.0;
            double len = Math.max(1, Math.hypot(dx, dy)), side = canonical ? 10 : -10;
            boolean twoWay = (t[0] + t[1]).equals("shipdf") || (t[0] + t[1]).equals("dfship")
                || (t[0] + t[1]).equals("paidhold") || (t[0] + t[1]).equals("holdpaid");
            java.awt.Point[] pts = twoWay ? new java.awt.Point[] {border(a, b, -dy / len * side, dx / len * side),
                                                               border(b, a, -dy / len * side, dx / len * side)} : null;
            IConnectorUIModel c = link(d, x, a, b);
            if (c != null && !t[2].isEmpty()) {
                c.setShowConnectorName(0);
                c.resetCaption();
            }
        }
    }

    // ------------------------------------------------------------------ ERD
    IDBTable table(String name, String[][] cols) {
        IDBTable t = f.createDBTable();
        t.setName(name);
        for (String[] c : cols) {
            IDBColumn col = f.createDBColumn();
            col.setName(c[0]);
            String type = c[1];
            int len = 0;
            if (type.contains("(")) {
                len = Integer.parseInt(type.substring(type.indexOf('(') + 1, type.indexOf(')')));
                type = type.substring(0, type.indexOf('('));
            }
            col.setType(type, len, 0);
            col.setPrimaryKey(c.length > 2 && c[2].contains("PK"));
            col.setNullable(c.length > 2 && c[2].contains("N"));
            col.setUnique(c.length > 2 && c[2].contains("U"));
            t.addDBColumn(col);
        }
        named.put("table:" + name, t);
        return t;
    }

    IShapeUIModel tableShape(IDiagramUIModel d, String name, int x, int y) {
        IDBTable t = (IDBTable) named.get("table:" + name);
        int rows = t.toDBColumnArray().length;
        int longest = name.length();
        for (IDBColumn c : t.toDBColumnArray()) {
            longest = Math.max(longest, c.getName().length() + c.getTypeInText().length() + 4);
        }
        return put(d, t, name, x, y, Math.max(170, (int) (longest * 7.2) + 56), 30 + rows * 17 + 6, null);
    }

    /** FK from parent (referenced) to child; the generated column is renamed, optionally part of PK. */
    void fk(IDiagramUIModel d, String parent, String child, String column, boolean pk, boolean optional) {
        IDBTable p = (IDBTable) named.get("table:" + parent), c = (IDBTable) named.get("table:" + child);
        IDBForeignKey k = f.createDBForeignKey();
        k.setFrom(p);
        k.setTo(c);
        k.setFromMultiplicity(IDBForeignKey.FROM_MULTIPLICITY_ONE);
        k.setToMultiplicity(IDBForeignKey.TO_MULTIPLICITY_ZERO_TO_MANY);
        java.util.Iterator<?> it = k.foreignKeyColumnsIterator();
        if (it.hasNext()) {
            IDBColumn col = (IDBColumn) it.next();
            col.setName(column);
            col.setPrimaryKey(pk);
            col.setNullable(optional);
        }
        link(d, k, shapes.get(parent), shapes.get(child));
    }

    void physicalErd() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_ER_DIAGRAM, "ERD01 Physical Data Model");
        table("users", new String[][] {{"user_id", "varchar(10)", "PK"}, {"name", "varchar(100)"}, {"email", "varchar(100)", "U"}, {"password_hash", "varchar(128)"}, {"role", "varchar(12)"}, {"created_at", "timestamp"}});
        table("address", new String[][] {{"receiver", "varchar(100)"}, {"phone", "varchar(20)"}, {"street", "varchar(150)"}, {"city", "varchar(60)"}});
        table("category", new String[][] {{"category_id", "varchar(20)", "PK"}, {"name", "varchar(60)"}});
        table("product", new String[][] {{"product_id", "varchar(10)", "PK"}, {"name", "varchar(120)"}, {"brand", "varchar(60)"}, {"color", "varchar(20)"}, {"price", "decimal(10)"}, {"description", "varchar(255)", "N"}, {"image", "varchar(255)", "N"}, {"status", "varchar(12)"}});
        table("stock_level", new String[][] {{"physical", "integer"}, {"reserved", "integer"}, {"threshold", "integer"}});
        table("inventory_event", new String[][] {{"event_id", "varchar(10)", "PK"}, {"kind", "varchar(10)"}, {"quantity", "integer"}, {"reference", "varchar(40)"}, {"reason", "varchar(100)", "N"}, {"created_at", "timestamp"}});
        table("replenishment_request", new String[][] {{"request_id", "varchar(10)", "PK"}, {"quantity", "integer"}, {"status", "varchar(20)"}, {"created_at", "timestamp"}});
        table("cart", new String[][] {{"cart_id", "varchar(20)", "PK"}});
        table("cart_item", new String[][] {{"name", "varchar(120)"}, {"cart_price", "decimal(10)"}, {"quantity", "integer"}});
        table("promotion", new String[][] {{"code", "varchar(20)", "PK"}, {"percent", "decimal(5)"}, {"min_total", "decimal(10)"}, {"start_date", "date"}, {"end_date", "date"}, {"active", "boolean"}});
        table("customer_order", new String[][] {{"order_id", "varchar(12)", "PK"}, {"address", "varchar(255)"}, {"discount", "decimal(10)"}, {"shipping_fee", "decimal(10)"}, {"total", "decimal(12)"}, {"status", "varchar(24)"}, {"created_at", "timestamp"}, {"promo_code", "varchar(20)", "N"}, {"idempotency_key", "varchar(64)", "U"}});
        table("order_item", new String[][] {{"name", "varchar(120)"}, {"unit_price", "decimal(10)"}, {"quantity", "integer"}});
        table("order_status_history", new String[][] {{"id", "integer", "PK"}, {"status", "varchar(24)"}, {"actor", "varchar(20)"}, {"at", "timestamp"}, {"note", "varchar(255)", "N"}});
        table("payment", new String[][] {{"payment_id", "varchar(12)", "PK"}, {"attempt_ref", "varchar(20)", "U"}, {"amount", "decimal(12)"}, {"currency", "varchar(3)"}, {"status", "varchar(12)"}, {"provider_ref", "varchar(40)", "N"}, {"created_at", "timestamp"}});
        table("shipment", new String[][] {{"shipment_id", "varchar(10)", "PK"}, {"carrier_ref", "varchar(20)", "N"}, {"status", "varchar(20)"}});
        table("shipment_milestone", new String[][] {{"seq", "integer", "PK"}, {"code", "varchar(20)"}, {"at", "timestamp"}, {"location", "varchar(100)", "N"}});
        table("review", new String[][] {{"review_id", "varchar(10)", "PK"}, {"rating", "integer"}, {"text", "varchar(1000)"}, {"status", "varchar(12)"}, {"created_at", "timestamp"}});
        table("audit_log", new String[][] {{"id", "integer", "PK"}, {"actor", "varchar(20)"}, {"action", "varchar(40)"}, {"entity", "varchar(20)"}, {"entity_id", "varchar(20)"}, {"detail", "varchar(255)", "N"}, {"at", "timestamp"}});
        tableShape(d, "users", 40, 40);
        tableShape(d, "address", 40, 270);
        tableShape(d, "cart", 330, 40);
        tableShape(d, "cart_item", 330, 170);
        tableShape(d, "customer_order", 330, 360);
        tableShape(d, "order_status_history", 40, 470);
        tableShape(d, "payment", 40, 660);
        tableShape(d, "order_item", 330, 640);
        tableShape(d, "shipment", 330, 800);
        tableShape(d, "shipment_milestone", 330, 950);
        tableShape(d, "category", 680, 40);
        tableShape(d, "product", 680, 170);
        tableShape(d, "review", 680, 470);
        tableShape(d, "promotion", 680, 680);
        tableShape(d, "stock_level", 980, 170);
        tableShape(d, "inventory_event", 980, 330);
        tableShape(d, "replenishment_request", 980, 560);
        tableShape(d, "audit_log", 980, 760);
        fk(d, "users", "address", "customer_id", true, false);
        fk(d, "users", "cart", "customer_id", false, false);
        fk(d, "cart", "cart_item", "cart_id", true, false);
        fk(d, "product", "cart_item", "product_id", true, false);
        fk(d, "users", "customer_order", "customer_id", false, false);
        fk(d, "customer_order", "order_item", "order_id", true, false);
        fk(d, "product", "order_item", "product_id", true, false);
        fk(d, "customer_order", "order_status_history", "order_id", false, false);
        fk(d, "customer_order", "payment", "order_id", false, false);
        fk(d, "customer_order", "shipment", "order_id", false, false);
        fk(d, "shipment", "shipment_milestone", "shipment_id", true, false);
        fk(d, "category", "product", "category_id", false, false);
        fk(d, "product", "stock_level", "product_id", true, false);
        fk(d, "product", "inventory_event", "product_id", false, false);
        fk(d, "product", "replenishment_request", "product_id", false, false);
        fk(d, "product", "review", "product_id", false, false);
        fk(d, "users", "review", "customer_id", false, false);
        fk(d, "customer_order", "review", "order_id", false, false);
        for (String t : new String[] {"address", "cart", "cart_item", "customer_order", "order_item", "order_status_history",
                                      "payment", "shipment", "shipment_milestone", "product", "stock_level",
                                      "inventory_event", "replenishment_request", "review"}) {
            IShapeUIModel s = shapes.get(t);
            int rows = ((IDBTable) named.get("table:" + t)).toDBColumnArray().length;
            s.setSize(s.getWidth() + 20, 30 + rows * 17 + 6);
        }
    }
}
