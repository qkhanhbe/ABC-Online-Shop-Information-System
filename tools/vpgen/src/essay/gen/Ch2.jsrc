        lifeline(d, "CheckoutController", "control", 320, 130, h);
        lifeline(d, "Cart", "entity", 510, 80, h);
        lifeline(d, "StockLevel", "entity", 640, 90, h);
        lifeline(d, "Order", "entity", 790, 80, h);
        lifeline(d, "PaymentGateway", "boundary", 930, 120, h);
