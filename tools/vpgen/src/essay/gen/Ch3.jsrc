    void reviewPipelineActivity() {
        IDiagramUIModel d = diagram(IDiagramTypeConstants.DIAGRAM_TYPE_ACTIVITY_DIAGRAM, "AD04 Review Insight Pipeline");
        d.setConnectorStyle(1);
        Node s = start(d, 287, 20);
        Node a1 = act(d, "Load published reviews of the product", 160, 70, 280);
        Node d0 = decision(d, "For each review: noise?", 245, 150);
        Node sk = act(d, "[Yes] Skip, count as noise", 470, 160, 220);
        Node a2 = act(d, "[No] Split into clauses (. , but however)", 160, 260, 280);
        Node a3 = act(d, "Detect aspects: quality, price, delivery, service", 160, 340, 280);
        Node a4 = act(d, "Score polarity with negation window (3 words)", 160, 420, 280);
        Node a5 = act(d, "Use star rating when a clause has no opinion word", 160, 500, 280);
        Node m = merge(d, 275, 580);
        Node d1 = decision(d, "At least 2 usable reviews?", 245, 640);
        Node f1 = act(d, "[No] Show 'Not enough reviews' (fallback)", 470, 650, 250);
        Node a6 = act(d, "[Yes] Aggregate +/- per aspect, keep evidence", 160, 750, 280);
        Node a7 = act(d, "Label: Mostly positive / Mixed / Mostly negative", 160, 830, 280);
        Node e1 = end(d, 286, 910);
        Node e2 = end(d, 581, 740);
        cflow(d, null, s, a1, null); cflow(d, null, a1, d0, null); cflow(d, null, d0, sk, "Yes");
        cflow(d, null, d0, a2, "No"); cflow(d, null, a2, a3, null); cflow(d, null, a3, a4, null);
        cflow(d, null, a4, a5, null); cflow(d, null, a5, m, null); cflow(d, null, sk, m, null);
        cflow(d, null, m, d1, null); cflow(d, null, d1, f1, "No"); cflow(d, null, f1, e2, null);
        cflow(d, null, d1, a6, "Yes"); cflow(d, null, a6, a7, null); cflow(d, null, a7, e1, null);
    }
}
