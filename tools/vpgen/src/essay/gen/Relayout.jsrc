package essay.gen;

import java.awt.Rectangle;
import java.io.File;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

import com.vp.plugin.ApplicationManager;
import com.vp.plugin.DiagramManager;
import com.vp.plugin.diagram.IConnectorUIModel;
import com.vp.plugin.diagram.IDiagramElement;
import com.vp.plugin.diagram.IDiagramUIModel;
import com.vp.plugin.diagram.IShapeUIModel;
import com.vp.plugin.diagram.shape.IActivityPartitionHeaderUIModel;
import com.vp.plugin.diagram.shape.IActivitySwimlane2CompartmentUIModel;
import com.vp.plugin.diagram.shape.IActivitySwimlane2NewUIModel;
import com.vp.plugin.model.IControlFlow;
import com.vp.plugin.model.IModelElement;
import com.vp.plugin.model.IProject;

/**
 * Hand layout for Visual Paradigm CE. CE only draws directed connectors (include, extend, flow,
 * dependency, foreign key ...) that it routes itself, so the shapes are placed so that straight
 * centre-to-centre lines do not cross shapes or labels, and every connector is re-created straight.
 *
 * Spec lines: CODE|name|x|y|w|h   (w/h -1 keeps the size; name may be @initial, @merge, @note)
 *             CODE|@lane|name|x|w   CODE|@frame|top|height   CODE|@guard|decision|yes|no
 *             CODE|@hide|name       CODE|@hidelink|from|to   CODE|@flow|package
 */
public class Relayout {

    final DiagramManager dm = ApplicationManager.instance().getDiagramManager();

    void run(IProject project, String specPath) throws Exception {
        Map<String, List<String[]>> spec = new LinkedHashMap<String, List<String[]>>();
        for (String line : Files.readAllLines(new File(specPath).toPath(), StandardCharsets.UTF_8)) {
            if (line.trim().isEmpty() || line.startsWith("#")) continue;
            String[] p = line.split("\\|", -1);
            spec.computeIfAbsent(p[0], k -> new ArrayList<String[]>()).add(p);
        }
        for (IDiagramUIModel d : project.toDiagramArray()) {
            String code = d.getName().split(" ")[0];
            List<String[]> lines = spec.get(code);
            if (lines != null) {
                apply(d, lines);
                System.out.println("RELAYOUT " + d.getName());
            }
        }
    }

    static String name(IDiagramElement e) {
        IModelElement m = e.getModelElement();
        return m == null || m.getName() == null ? "" : m.getName();
    }

    static String type(IDiagramElement e) {
        IModelElement m = e.getModelElement();
        return m == null ? "" : m.getModelType();
    }

    void apply(IDiagramUIModel d, List<String[]> lines) {
        Map<String, Rectangle> before = new HashMap<String, Rectangle>();
        for (IShapeUIModel s : d.toShapeUIModelArray()) {
            before.put(s.getId(), new Rectangle(s.getX(), s.getY(), s.getWidth(), s.getHeight()));
        }
        Set<String> placed = new HashSet<String>();
        List<IShapeUIModel> containers = new ArrayList<IShapeUIModel>();
        List<String[]> lanes = new ArrayList<String[]>();
        int frameTop = -1, frameHeight = -1;
        Map<String, String[]> guards = new HashMap<String, String[]>();
        List<String> flows = new ArrayList<String>();

        for (String[] p : lines) {
            String key = p[1];
            if ("@lane".equals(key)) { lanes.add(p); continue; }
            if ("@frame".equals(key)) { frameTop = Integer.parseInt(p[2]); frameHeight = Integer.parseInt(p[3]); continue; }
            if ("@guard".equals(key)) { guards.put(p[2], new String[] {p[3], p[4]}); continue; }
            if ("@flow".equals(key)) { flows.add(p[2]); continue; }
            if ("@hide".equals(key)) { hide(d, p[2]); continue; }
            if ("@hidelink".equals(key)) { hideLink(d, p[2], p[3]); continue; }
            if ("@nostereo".equals(key)) { d.setShowStereotypes(false); continue; }
            if ("@addnote".equals(key)) {
                com.vp.plugin.model.INOTE n = com.vp.plugin.model.factory.IModelElementFactory.instance().createNOTE();
                n.setDescription(p[2]);
                IShapeUIModel ns = (IShapeUIModel) dm.createDiagramElement(d, n);
                ns.setBounds(Integer.parseInt(p[3]), Integer.parseInt(p[4]), Integer.parseInt(p[5]), Integer.parseInt(p[6]));
                java.awt.Color yellow = new java.awt.Color(255, 242, 204);
                ns.setBackground(yellow);
                try { ns.getFillColor().setValues(1, yellow, yellow, 0, 0, true); } catch (Throwable ignored) { }
                placed.add(ns.getId());
                continue;
            }
            IShapeUIModel s = find(d, key);
            if (s == null) {
                System.out.println("  NOT FOUND " + key);
                continue;
            }
            int w = Integer.parseInt(p[4]), h = Integer.parseInt(p[5]);
            s.setBounds(Integer.parseInt(p[2]), Integer.parseInt(p[3]), w < 0 ? s.getWidth() : w, h < 0 ? s.getHeight() : h);
            placed.add(s.getId());
            String t = type(s);
            if (t.equals("System") || t.equals("Package") || t.equals("Node")) containers.add(s);
        }

        // nested shapes follow their container (unless placed explicitly or re-flowed)
        for (IShapeUIModel c : containers) {
            Rectangle old = before.get(c.getId());
            int dx = c.getX() - old.x, dy = c.getY() - old.y;
            List<IShapeUIModel> inside = new ArrayList<IShapeUIModel>();
            for (IShapeUIModel s : d.toShapeUIModelArray()) {
                Rectangle r = before.get(s.getId());
                if (s.getId().equals(c.getId()) || r == null || placed.contains(s.getId())
                    || !old.contains(r.getCenterX(), r.getCenterY()) || r.width * r.height >= old.width * old.height) continue;
                inside.add(s);
            }
            if (flows.contains(name(c))) {
                flow(c, inside, before);
            } else {
                for (IShapeUIModel s : inside) {
                    Rectangle r = before.get(s.getId());
                    if (s.getX() == r.x && s.getY() == r.y) s.setBounds(r.x + dx, r.y + dy, r.width, r.height);
                }
            }
            for (IShapeUIModel s : inside) placed.add(s.getId());
        }

        if (!lanes.isEmpty()) layoutLanes(d, lanes, frameTop, frameHeight);
        for (IShapeUIModel s : d.toShapeUIModelArray()) {
            s.resetCaption();
        }
        if (!guards.isEmpty() || d.getName().startsWith("AD")) renameDecisions(d, guards);
        placeFinals(d);
        for (IShapeUIModel s : d.toShapeUIModelArray()) {
            s.resetCaption();
        }
        redraw(d);
    }

    /** Classes of a package laid out left to right, wrapping at the package's right edge. */
    void flow(IShapeUIModel pkg, List<IShapeUIModel> inside, Map<String, Rectangle> before) {
        inside.sort((a, b) -> before.get(a.getId()).y != before.get(b.getId()).y ? before.get(a.getId()).y - before.get(b.getId()).y : before.get(a.getId()).x - before.get(b.getId()).x);
        int x = pkg.getX() + 15, y = pkg.getY() + 40, right = pkg.getX() + pkg.getWidth() - 10;
        for (IShapeUIModel s : inside) {
            if (x + s.getWidth() > right) { x = pkg.getX() + 15; y += 48; }
            s.setBounds(x, y, s.getWidth(), s.getHeight());
            x += s.getWidth() + 12;
        }
        int need = y + 48 - pkg.getY();
        if (need > pkg.getHeight()) pkg.setBounds(pkg.getX(), pkg.getY(), pkg.getWidth(), need);
    }

    IShapeUIModel find(IDiagramUIModel d, String key) {
        for (IShapeUIModel s : d.toShapeUIModelArray()) {
            String t = type(s);
            if ("@initial".equals(key) && t.equals("InitialNode")) return s;
            if ("@merge".equals(key) && t.equals("MergeNode")) return s;
            if ("@note".equals(key) && t.equals("NOTE")) return s;
            if (key.equals(name(s)) && !(s instanceof IActivityPartitionHeaderUIModel)) return s;
        }
        return null;
    }

    void hide(IDiagramUIModel d, String key) {
        IShapeUIModel s = find(d, key);
        if (s == null) return;
        for (IDiagramElement e : d.toDiagramElementArray()) {
            if (e instanceof IConnectorUIModel) {
                IConnectorUIModel c = (IConnectorUIModel) e;
                if ((c.getFromShape() != null && c.getFromShape().getId().equals(s.getId())) || (c.getToShape() != null && c.getToShape().getId().equals(s.getId()))) e.deleteViewOnly();
            }
        }
        s.deleteViewOnly();
    }

    void hideLink(IDiagramUIModel d, String from, String to) {
        for (IDiagramElement e : d.toDiagramElementArray()) {
            if (!(e instanceof IConnectorUIModel)) continue;
            IConnectorUIModel c = (IConnectorUIModel) e;
            if (c.getFromShape() != null && c.getToShape() != null
                && from.equals(name(c.getFromShape())) && to.equals(name(c.getToShape()))) {
                e.deleteViewOnly();
            }
        }
    }

    void layoutLanes(IDiagramUIModel d, List<String[]> lanes, int top, int height) {
        List<IShapeUIModel> cells = new ArrayList<IShapeUIModel>();
        IActivitySwimlane2NewUIModel frame = null;
        for (IShapeUIModel s : d.toShapeUIModelArray()) {
            if (s instanceof IActivitySwimlane2CompartmentUIModel) cells.add(s);
            if (s instanceof IActivitySwimlane2NewUIModel) frame = (IActivitySwimlane2NewUIModel) s;
        }
        cells.sort((a, b) -> a.getX() - b.getX());
        int left = Integer.MAX_VALUE, right = 0;
        for (int i = 0; i < lanes.size(); i++) {
            String[] p = lanes.get(i);
            int x = Integer.parseInt(p[3]), w = Integer.parseInt(p[4]);
            for (IShapeUIModel s : d.toShapeUIModelArray()) {
                if (s instanceof IActivityPartitionHeaderUIModel && p[2].equals(name(s))) {
                    s.setBounds(x, top, w, 34);
                    s.resetCaption();
                }
            }
            if (i < cells.size()) cells.get(i).setBounds(x, top + 34, w, height - 34);
            left = Math.min(left, x);
            right = Math.max(right, x + w);
        }
        if (frame != null) frame.setBounds(left, top, right - left, height);
    }

    /** Decision questions move into the guards: "Cart valid?" + [Yes] becomes [cart valid]. */
    void renameDecisions(IDiagramUIModel d, Map<String, String[]> guards) {
        for (IDiagramElement e : d.toDiagramElementArray()) {
            if (!(e instanceof IConnectorUIModel) || !(e.getModelElement() instanceof IControlFlow)) continue;
            IConnectorUIModel c = (IConnectorUIModel) e;
            IControlFlow f = (IControlFlow) e.getModelElement();
            String[] g = c.getFromShape() == null ? null : guards.get(name(c.getFromShape()));
            if (g != null && f.getGuard() != null) {
                if ("Yes".equals(f.getGuard())) f.setGuard(g[0]);
                else if ("No".equals(f.getGuard())) f.setGuard(g[1]);
            }
        }
        for (IShapeUIModel s : d.toShapeUIModelArray()) {
            IModelElement m = s.getModelElement();
            if (m == null) continue;
            if (type(s).equals("DecisionNode") && guards.containsKey(m.getName())) {
                m.setName("");
            } else if (type(s).equals("ActivityAction") && m.getName() != null) {
                m.setName(m.getName().replaceFirst("^\\[(Yes|No)\\] ", ""));
            }
            s.resetCaption();
        }
    }

    void placeFinals(IDiagramUIModel d) {
        for (IDiagramElement e : d.toDiagramElementArray()) {
            if (!(e instanceof IConnectorUIModel)) continue;
            IConnectorUIModel c = (IConnectorUIModel) e;
            IShapeUIModel to = c.getToShape(), from = c.getFromShape();
            if (to == null || from == null || !type(to).equals("ActivityFinalNode")) continue;
            int cx = from.getX() + from.getWidth() / 2;
            to.setBounds(cx - 14, from.getY() + from.getHeight() + 40, 28, 28);
        }
    }

    /** Every connector straight, without route points (the only form CE draws for all types). */
    void redraw(IDiagramUIModel d) {
        for (IDiagramElement e : d.toDiagramElementArray()) {
            if (!(e instanceof IConnectorUIModel) || e.getModelElement() == null) continue;
            IConnectorUIModel old = (IConnectorUIModel) e;
            IShapeUIModel a = old.getFromShape(), b = old.getToShape();
            if (a == null || b == null) continue;
            IModelElement m = e.getModelElement();
            e.deleteViewOnly();
            IConnectorUIModel c = (IConnectorUIModel) dm.createConnector(d, m, a, b, null);
            if (c != null) {
                c.setConnectorStyle(IConnectorUIModel.CS_OBLIQUE);
                c.setShowConnectorName(0);
                c.resetCaption();
                if (m instanceof IControlFlow && ((IControlFlow) m).getGuard() != null && !((IControlFlow) m).getGuard().isEmpty()) {
                    sideCaption(c, a, b);
                }
            }
        }
    }

    /** A guard on a vertical flow is drawn on top of the line: move it to the right of the line. */
    void sideCaption(IConnectorUIModel c, IShapeUIModel a, IShapeUIModel b) {
        int ax = a.getX() + a.getWidth() / 2, bx = b.getX() + b.getWidth() / 2;
        if (Math.abs(ax - bx) > 25) return;
        try {
            com.vp.plugin.diagram.ICaptionUIModel cap = ((com.vp.plugin.diagram.IBaseDiagramElement) c).getCaptionUIModel();
            if (cap == null) return;
            int top = a.getY() + a.getHeight(), bottom = b.getY();
            int w = 11 * (((IControlFlow) c.getModelElement()).getGuard().length() + 3);
            cap.setX((ax + bx) / 2 + 6);
            cap.setY((top + bottom) / 2 - 12);
            cap.setWidth(w);
            cap.setHeight(24);
            c.setRequestResetCaption(false);
            System.out.println("  CAPTION " + ((IControlFlow) c.getModelElement()).getGuard() + " -> " + cap.getX() + "," + cap.getY());
        } catch (Throwable t) {
            System.out.println("  CAPTION FAILED " + t);
        }
    }
}
